{
  "name": "omsk-gui",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "open": "vite --open",
    "compile:electron": "tsc electron/main.ts electron/preload.ts --outDir electron/dist --module commonjs --target ES2022 --skipLibCheck",
    "app:dev": "electron .",
    "app:dist": "tsc electron/main.ts electron/preload.ts --outDir electron/dist --module commonjs --target ES2022 --skipLibCheck && electron-builder --win dir",
    "app:package": "tsc electron/main.ts electron/preload.ts --outDir electron/dist --module commonjs --target ES2022 --skipLibCheck && electron-builder --win portable"
  },
  "dependencies": {
    "framer-motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "34.3.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  },
  "description": "Official Deep Ocean Graphical Interface for Oh My Shark (OMSK)",
  "main": "electron/dist/main.cjs",
  "build": {
    "appId": "com.lucasentweihen.omskgui",
    "productName": "OMSK GUI",
    "directories": {
      "output": "release-app"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}.${ext}"
  },
  "productName": "OMSK GUI"
}
